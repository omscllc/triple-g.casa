{#
  Display a contact card node.
#}

<div class="text-nowrap d-flex flex-column align-items-center row-gap-4 border border-white border-1 p-3 rounded-3">
  <div class="card-icon">
    <i class="{{ node.field_fa_icon_pack.0.value|replace({'_': '-'}) }} {{ node.field_fa_icon.0.value|replace({'_': '-'}) }} fa-in fs-1"></i>
  </div>
  <div class="card-link">
    {{ content.field_contact_info }}
  </div>
</div>
